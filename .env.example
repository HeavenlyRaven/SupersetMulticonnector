# Copy this file to .env and fill in every value before `fedctl up`.
# .env is gitignored — never commit real credentials.

# --- Superset metadata database (external PostgreSQL) ----------------------
# Required. Must point at an existing PostgreSQL instance outside this
# stack — there is no Postgres container here, and no SQLite fallback.
# fedctl and Superset both refuse to start if this is unset or SQLite.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://superset:changeme@postgres.example.internal:5432/superset

# Flask's session/CSRF signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=

# --- Superset admin user (bootstrapped once by `fedctl up`) -----------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=changeme

# --- ClickHouse roles (clickhouse/users.d/roles.xml) ------------------------
# fed_admin: used only by fedctl (CREATE/DROP DATABASE, named collections).
FEDCTL_ADMIN_USER=fed_admin
FEDCTL_ADMIN_PASSWORD=changeme

# bi_ro: used only by Superset's own ClickHouse connection (readonly=2).
SUPERSET_CH_USER=bi_ro
SUPERSET_CH_PASSWORD=changeme

# --- Join tuning (spec section 8, applied to the bi_ro profile) ------------
CLICKHOUSE_MAX_BYTES_IN_JOIN=2000000000
CLICKHOUSE_MAX_MEMORY_USAGE=4000000000

# --- Container resource limits ----------------------------------------------
CLICKHOUSE_MEMORY_LIMIT=4g
SUPERSET_MEMORY_LIMIT=4g

# --- Superset timeouts / worker pool ----------------------------------------
# No Celery means concurrent long queries hold gunicorn workers directly —
# size WEB_CONCURRENCY generously and keep SQLLAB_TIMEOUT firm. See the
# README's "What was removed" section.
SQLLAB_TIMEOUT=300
SUPERSET_WEBSERVER_TIMEOUT=300
WEB_CONCURRENCY=8

# --- Networking --------------------------------------------------------------
SUPERSET_PORT=8088

# --- SSRF allowlist ----------------------------------------------------------
# Comma-separated hostnames, IPs, or CIDRs that may bypass the default
# denial of private/loopback/link-local source hosts (validate.Host).
# Needed for compose.dev.yaml's sample databases, which live on the
# internal docker network:
FEDCTL_ALLOWED_SOURCE_HOSTS=dev-postgres,dev-mysql

# --- Extensions (dev only) --------------------------------------------------
# Set to the extension source tree's frontend build output to iterate
# without rebuilding a .supx bundle each time. Leave unset in production —
# EXTENSIONS_PATH (baked into images/superset/Dockerfile) is used instead.
LOCAL_EXTENSIONS=
